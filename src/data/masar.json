    "acceptance_criteria": [
      "مؤلفه من أهل السنة (أشعري أو ماتريدي) ومعروف بالفقه",
      "يجمع بين الشريعة والحقيقة",
      "نسبته لمؤلفه ثابتة وتتوفر طبعة محققة",
      "التزكية فيه قائمة على الاستقامة لا على الكرامات والأسرار",
      "أجازته اللجنة العلمية صراحة"
    ],
    "excluded_categories": [
      "كتب الأوفاق والجداول والطلاسم والحروف والجفر",
      "كتب السحر والكهانة والتنجيم والرمل",
      "المتون التي فيها ادعاء الحلول والاتحاد أو الإباحية",
      "الكتب المنسوبة للصالحين بلا سند، أو القائمة على الخوارق دون الاستقامة"
    ]
  },
